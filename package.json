{
  "name": "chainlog",
  "version": "0.2.0",
  "description": "Tamper-proof audit trails for AI agents. Verifiable by anyone. Alterable by no one.",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage",
    "deploy:sepolia": "hardhat ignition deploy ignition/modules/ChainLog.ts --network baseSepolia",
    "deploy:mainnet": "hardhat ignition deploy ignition/modules/ChainLog.ts --network base",
    "deploy:registry:sepolia": "hardhat ignition deploy ignition/modules/ModelVersionRegistry.ts --network baseSepolia",
    "deploy:registry:mainnet": "hardhat ignition deploy ignition/modules/ModelVersionRegistry.ts --network base",
    "deploy:dms:sepolia": "hardhat ignition deploy ignition/modules/DeadMansSwitch.ts --network baseSepolia --parameters ignition/params/dms.json",
    "deploy:dms:mainnet": "hardhat ignition deploy ignition/modules/DeadMansSwitch.ts --network base --parameters ignition/params/dms.json",
    "clean": "hardhat clean"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AreteDriver/chainlog.git"
  },
  "keywords": [
    "ai",
    "audit",
    "blockchain",
    "base",
    "compliance",
    "immutable",
    "logging",
    "agents"
  ],
  "author": "ARETE (James C. Young)",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/AreteDriver/chainlog/issues"
  },
  "homepage": "https://github.com/AreteDriver/chainlog#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.0",
    "hardhat": "~3.16.0",
    "lodash-es": "^4.18.1"
  },
  "overrides": {
    "picomatch": "^4.0.4",
    "brace-expansion": "^5.0.5",
    "serialize-javascript": "^7.0.5",
    "adm-zip": "^0.6.0",
    "lodash-es": "^4.18.1"
  }
}
